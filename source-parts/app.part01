  if (tab === 'pedidos') content.innerHTML = `<section class="account-card"><h3>Pedidos creados desde este dispositivo</h3><div class="orders-list">${state.orders.length ? state.orders.map((order) => `<article class="order-row"><div><strong>${escapeHtml(order.id)}</strong><small style="display:block;color:var(--text-2)">${new Date(order.createdAt).toLocaleString('es-CR')} · ${order.items.length} líneas</small></div><div><span class="status">${escapeHtml(order.status)}</span><b style="display:block;margin-top:5px">${money(order.total)}</b></div></article>`).join('') : '<div class="empty">No hay pedidos guardados.</div>'}</div></section>`;
}

async function submitOrder(event) {
  event.preventDefault();
  const button = $('#submit-order');
  button.disabled = true;
  button.textContent = 'Creando pedido…';
  try {
    state.profile = { name: $('#ck-nombre').value.trim(), email: $('#ck-email').value.trim(), phone: $('#ck-phone').value.trim(), address: $('#ck-dir').value.trim() };
    const order = await api('/api/orders', { method: 'POST', body: JSON.stringify({ customerName: state.profile.name, email: state.profile.email, phone: state.profile.phone, address: state.profile.address, paymentMethod: $('#ck-pago').value, couponCode: state.coupon?.code || null, items: state.cart }) });
    state.orders.unshift(order);
    for (const line of order.items) {
      const product = state.products.find((item) => item.id === line.productId);
      if (product) { product.stock -= line.quantity; product.vendidos += line.quantity; }
    }
    state.cart = [];
    state.coupon = null;
    persist();
    renderCatalog();
    renderCart();
    $('#modal-checkout').classList.remove('open');
    closeCart();
    $('#panel-cuenta').classList.add('open');
    renderAccount('pedidos');
    toast(`Pedido ${order.id} creado`);
  } catch (error) {
    toast(error.message);
  } finally {
    button.disabled = false;
    button.textContent = 'Confirmar pedido';
  }
}

async function ensureAdmin() {
  try {
    await api('/api/admin/session');
    state.admin.authenticated = true;
    await loadAdmin();
    $('#panel-admin').classList.add('open');
  } catch {
    $('#modal-admin-login').classList.add('open');
  }
}

async function adminLogin(event) {
  event.preventDefault();
  try {
    await api('/api/admin/login', { method: 'POST', body: JSON.stringify({ token: $('#admin-token').value }) });
    state.admin.authenticated = true;
    $('#modal-admin-login').classList.remove('open');
    await loadAdmin();
    $('#panel-admin').classList.add('open');
  } catch (error) { toast(error.message); }
}

async function loadAdmin() {
  const [data, products, orders, coupons, settings] = await Promise.all([
    api('/api/admin/dashboard'), api('/api/admin/products'), api('/api/admin/orders'), api('/api/admin/coupons'), api('/api/admin/settings'),
  ]);
  Object.assign(state.admin, { data, products, orders, coupons, settings });
  renderAdmin(state.admin.section);
}

function metricCard(label, value, hint = '') { return `<article class="stat-card"><h4>${escapeHtml(label)}</h4><div class="val">${escapeHtml(value)}</div><small>${escapeHtml(hint)}</small></article>`; }

function renderAdmin(section) {
  state.admin.section = section;
  $$('#admin-nav button').forEach((button) => button.classList.toggle('active', button.dataset.sec === section));
  const el = $('#admin-content');
  const data = state.admin.data;
  if (!data) { el.innerHTML = '<div class="empty">Cargando…</div>'; return; }
  if (section === 'dashboard') {
    el.innerHTML = `<div class="stat-grid">${metricCard('Ventas', money(data.metrics.revenue), 'Pedidos no cancelados')}${metricCard('Pedidos', data.metrics.orders)}${metricCard('Ticket promedio', money(data.metrics.averageTicket))}${metricCard('Clientes', data.metrics.customers)}${metricCard('Productos activos', data.metrics.activeProducts)}${metricCard('Stock crítico', data.metrics.lowStock)}</div><div class="admin-grid"><section class="admin-card"><h3>Bajo stock</h3><div class="movement-list">${data.lowStockProducts.map((product) => `<div class="movement-row"><span>${escapeHtml(product.nombre)}</span><b>${product.stock}</b></div>`).join('') || '<p>Sin alertas.</p>'}</div></section><section class="admin-card"><h3>Pedidos recientes</h3><div class="movement-list">${data.recentOrders.slice(0, 6).map((order) => `<div class="movement-row"><div><strong>${escapeHtml(order.id)}</strong><small style="display:block">${escapeHtml(order.customerName)}</small></div><b>${money(order.total)}</b></div>`).join('')}</div></section></div>`;
  }
  if (section === 'productos') renderAdminProducts();
  if (section === 'inventario') renderAdminInventory();
  if (section === 'pedidos') renderAdminOrders();
  if (section === 'clientes') renderAdminCustomers();
  if (section === 'promos') renderAdminCoupons();
  if (section === 'analitica') renderAdminAnalytics();
  if (section === 'config') renderAdminSettings();
}

function renderAdminProducts() {
  const el = $('#admin-content');
  el.innerHTML = `<div class="admin-toolbar"><div><h2>Productos</h2><p>${state.admin.products.length} registrados</p></div><button class="btn-primary" id="new-product">Nuevo producto</button></div><div id="product-editor"></div><div class="table-wrap"><table class="table"><thead><tr><th>Producto</th><th>Precio</th><th>Stock</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>${state.admin.products.map((product) => `<tr><td><div class="product-cell"><img src="${escapeHtml(product.imgs[0])}" alt=""><div><strong>${escapeHtml(product.nombre)}</strong><small style="display:block">${escapeHtml(product.categoria)} · ${escapeHtml(product.marca)}</small></div></div></td><td>${money(priceOf(product))}</td><td><span class="stock-pill ${product.stock <= 3 ? 'low' : ''}">${product.stock}</span></td><td>${product.activo ? 'Publicado' : 'Archivado'}</td><td><button class="btn-ghost" data-edit-product="${escapeHtml(product.id)}">Editar</button> <button class="btn-ghost danger" data-delete-product="${escapeHtml(product.id)}">Archivar</button></td></tr>`).join('')}</tbody></table></div>`;
}

function productEditor(product = null) {
  const p = product || { nombre: '', marca: 'LÚA', categoria: 'Zapatos', precio: 0, descuento: 0, stock: 0, tallas: ['Única'], colores: [{ n: 'negro', h: '#1C1C1E' }], desc: '', imgs: [], nuevo: true, activo: true };
  $('#product-editor').innerHTML = `<form class="admin-card admin-form" id="product-form"><h3>${product ? 'Editar' : 'Nuevo'} producto</h3><input type="hidden" id="pf-id" value="${escapeHtml(product?.id || '')}"><div class="form-grid"><label>Nombre<input id="pf-name" class="input" required value="${escapeHtml(p.nombre)}"></label><label>Marca<input id="pf-brand" class="input" required value="${escapeHtml(p.marca)}"></label><label>Categoría<input id="pf-category" class="input" required value="${escapeHtml(p.categoria)}"></label><label>Precio<input id="pf-price" class="input" type="number" min="0" required value="${p.precio}"></label><label>Descuento %<input id="pf-discount" class="input" type="number" min="0" max="100" value="${p.descuento}"></label><label>Stock<input id="pf-stock" class="input" type="number" min="0" value="${p.stock}"></label><label>Tallas, separadas por coma<input id="pf-sizes" class="input" value="${escapeHtml(p.tallas.join(', '))}"></label><label>Colores nombre:#hex<input id="pf-colors" class="input" value="${escapeHtml(p.colores.map((item) => `${item.n}:${item.h}`).join(', '))}"></label><label style="grid-column:1/-1">Imágenes, una URL por línea<textarea id="pf-images">${escapeHtml(p.imgs.join('\n'))}</textarea></label><label style="grid-column:1/-1">Descripción<textarea id="pf-desc">${escapeHtml(p.desc)}</textarea></label></div><div class="admin-form-actions"><button type="button" class="btn-ghost" id="cancel-product">Cancelar</button><button class="btn-primary">Guardar</button></div></form>`;
}

async function saveProduct(event) {
  event.preventDefault();
  const id = $('#pf-id').value;
  const colors = $('#pf-colors').value.split(',').map((entry) => { const index = entry.lastIndexOf(':'); return { n: entry.slice(0, index).trim(), h: entry.slice(index + 1).trim() }; }).filter((item) => item.n && item.h);
  const payload = { nombre: $('#pf-name').value, marca: $('#pf-brand').value, categoria: $('#pf-category').value, precio: Number($('#pf-price').value), descuento: Number($('#pf-discount').value), stock: Number($('#pf-stock').value), tallas: $('#pf-sizes').value.split(',').map((item) => item.trim()).filter(Boolean), colores: colors, imgs: $('#pf-images').value.split('\n').map((item) => item.trim()).filter(Boolean), desc: $('#pf-desc').value, activo: true };
  try {
    await api(id ? `/api/admin/products/${encodeURIComponent(id)}` : '/api/admin/products', { method: id ? 'PUT' : 'POST', body: JSON.stringify(payload) });
    await reloadStoreAndAdmin();
    toast('Producto guardado');
  } catch (error) { toast(error.message); }
}

async function archiveProduct(id) {
  if (!confirm('¿Archivar este producto?')) return;
  try { await api(`/api/admin/products/${encodeURIComponent(id)}`, { method: 'DELETE' }); await reloadStoreAndAdmin(); toast('Producto archivado'); } catch (error) { toast(error.message); }
}

function renderAdminInventory() {
  $('#admin-content').innerHTML = `<div class="admin-toolbar"><div><h2>Inventario</h2><p>Ajustes con trazabilidad.</p></div></div><div class="table-wrap"><table class="table"><thead><tr><th>Producto</th><th>Stock</th><th>Ajuste</th></tr></thead><tbody>${state.admin.products.map((product) => `<tr><td>${escapeHtml(product.nombre)}</td><td>${product.stock}</td><td><button class="btn-ghost" data-stock="-1" data-product-id="${product.id}">−1</button> <button class="btn-ghost" data-stock="1" data-product-id="${product.id}">+1</button> <button class="btn-ghost" data-stock="5" data-product-id="${product.id}">+5</button></td></tr>`).join('')}</tbody></table></div><section class="admin-card" style="margin-top:16px"><h3>Movimientos recientes</h3><div class="movement-list">${state.admin.data.movements.map((movement) => `<div class="movement-row"><div><strong>${escapeHtml(movement.productName)}</strong><small style="display:block">${escapeHtml(movement.note)} · ${new Date(movement.createdAt).toLocaleString('es-CR')}</small></div><b class="${movement.quantity > 0 ? 'positive' : 'negative'}">${movement.quantity > 0 ? '+' : ''}${movement.quantity}</b></div>`).join('') || '<p>Sin movimientos.</p>'}</div></section>`;
}

async function adjustStock(productId, quantity) {
  const note = prompt('Nota del movimiento:', quantity > 0 ? 'Entrada manual' : 'Ajuste manual') || 'Ajuste manual';
  try { await api('/api/admin/inventory', { method: 'POST', body: JSON.stringify({ productId, quantity, note }) }); await reloadStoreAndAdmin(); toast('Inventario actualizado'); } catch (error) { toast(error.message); }
}

function renderAdminOrders() {
  $('#admin-content').innerHTML = `<div class="admin-toolbar"><div><h2>Pedidos</h2><p>Estados y totales calculados por el servidor.</p></div></div><div class="table-wrap"><table class="table"><thead><tr><th>Pedido</th><th>Cliente</th><th>Fecha</th><th>Total</th><th>Estado</th></tr></thead><tbody>${state.admin.orders.map((order) => `<tr><td><strong>${escapeHtml(order.id)}</strong><small style="display:block">${order.items.reduce((sum, item) => sum + item.quantity, 0)} unidades · ${escapeHtml(order.paymentMethod)}</small></td><td>${escapeHtml(order.customerName)}<small style="display:block">${escapeHtml(order.email)} · ${escapeHtml(order.phone)}</small></td><td>${new Date(order.createdAt).toLocaleString('es-CR')}</td><td>${money(order.total)}</td><td><select data-order-status="${escapeHtml(order.id)}">${['Pendiente','Pagado','Preparando','Enviado','Entregado','Cancelado'].map((status) => `<option ${status === order.status ? 'selected' : ''}>${status}</option>`).join('')}</select></td></tr>`).join('')}</tbody></table></div>`;
}

async function updateOrderStatus(id, status) {
  try { await api(`/api/admin/orders/${encodeURIComponent(id)}`, { method: 'PATCH', body: JSON.stringify({ status }) }); await reloadStoreAndAdmin(); toast('Estado actualizado'); } catch (error) { toast(error.message); await loadAdmin(); }
}

function renderAdminCustomers() {
  $('#admin-content').innerHTML = `<div class="admin-toolbar"><div><h2>Clientes</h2><p>Generados automáticamente desde pedidos válidos.</p></div></div><div class="table-wrap"><table class="table"><thead><tr><th>Cliente</th><th>Contacto</th><th>Pedidos</th><th>Total comprado</th><th>Última compra</th></tr></thead><tbody>${state.admin.data.customers.map((customer) => `<tr><td><strong>${escapeHtml(customer.name)}</strong><small style="display:block">${escapeHtml(customer.address)}</small></td><td>${escapeHtml(customer.email)}<small style="display:block">${escapeHtml(customer.phone)}</small></td><td>${customer.orderCount}</td><td>${money(customer.totalSpent)}</td><td>${new Date(customer.lastOrderAt).toLocaleDateString('es-CR')}</td></tr>`).join('')}</tbody></table></div>`;
}

function renderAdminCoupons() {
