.switch{appearance:none;width:46px;height:28px;background:#cfd3;border-radius:14px;position:relative;cursor:pointer;transition:.2s;flex-shrink:0}
.switch:checked{background:var(--accent)}
.switch::after{content:'';position:absolute;top:3px;left:3px;width:22px;height:22px;background:white;border-radius:50%;transition:.2s;box-shadow:0 1px 3px rgba(0,0,0,.2)}
.switch:checked::after{left:21px}

.hidden{display:none !important}
.empty{padding:40px;text-align:center;color:var(--text-2)}
.pill{display:inline-flex;align-items:center;gap:6px;padding:6px 10px;border-radius:999px;background:var(--bg);border:1px solid var(--border);font-size:12px;font-weight:700}
.modal-close{float:right;width:40px;height:40px;border-radius:50%;background:var(--bg);font-size:24px}.action-row,.coupon-row{display:flex;gap:10px;align-items:center}.action-row .btn-primary{flex:1}.drawer-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.35);z-index:190}.checkout-card,.login-card{max-width:620px;padding:24px;display:grid;gap:16px}.checkout-total{display:flex;justify-content:space-between;background:var(--bg);padding:16px;border-radius:14px}.account-card,.admin-card{background:var(--bg-elev);border:1px solid var(--border);border-radius:var(--radius-md);padding:18px;box-shadow:var(--shadow)}.account-card h3,.admin-card h3{margin-top:0}.orders-list,.movement-list,.coupon-list{display:grid;gap:10px}.order-row,.movement-row,.coupon-row-card{display:flex;justify-content:space-between;gap:12px;align-items:center;background:var(--bg);padding:12px;border-radius:14px}.status{display:inline-flex;padding:5px 9px;border-radius:999px;background:var(--bg);font-size:12px;font-weight:700}.danger{color:#b42318}.positive{color:#137333}.negative{color:#b42318}.admin-toolbar{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:14px}.admin-form{display:grid;gap:12px;margin-bottom:16px}.admin-form-actions{display:flex;gap:8px;justify-content:flex-end}.product-cell{display:flex;align-items:center;gap:10px}.product-cell img{width:48px;height:48px;border-radius:10px;object-fit:cover}.stock-pill{display:inline-flex;padding:5px 9px;border-radius:999px;background:#e8f5e9;color:#137333;font-weight:700}.stock-pill.low{background:#fff1d6;color:#9a5b00}.chart-list{display:grid;gap:12px}.chart-row{display:grid;grid-template-columns:140px 1fr 60px;gap:10px;align-items:center}.chart-bar{height:10px;background:var(--bg);border-radius:999px;overflow:hidden}.chart-bar span{display:block;height:100%;background:var(--accent);border-radius:999px}.admin-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}@media(max-width:860px){.admin-side{width:160px}.admin-grid{grid-template-columns:1fr}}@media(max-width:640px){.admin-layout{display:block}.admin-side{width:100%;border-right:0;border-bottom:1px solid var(--border);overflow:auto}.admin-nav{display:flex}.admin-nav button{white-space:nowrap}.admin-main{max-height:none}.header .icon-btn:nth-of-type(1){display:none}}
