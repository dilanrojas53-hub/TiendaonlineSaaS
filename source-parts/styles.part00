:root{
  --bg:#F7F5F2;
  --bg-elev:#FFFFFF;
  --text:#1C1C1E;
  --text-2:#6B6B6B;
  --accent:#C96A4A;
  --accent-2:#D98B6D;
  --border:rgba(0,0,0,.08);
  --shadow:0 10px 30px rgba(0,0,0,.08);
  --radius-lg:28px;
  --radius-md:22px;
  --radius-sm:16px;
  --blur:saturate(180%) blur(20px);
}
[data-theme="dark"]{
  --bg:#0F0F10;
  --bg-elev:#1C1C1E;
  --text:#F5F5F7;
  --text-2:#A1A1A6;
  --border:rgba(255,255,255,.12);
  --shadow:0 10px 30px rgba(0,0,0,.5);
}
*{box-sizing:border-box}
html,body{margin:0;padding:0;font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display",Inter,system-ui,sans-serif;background:var(--bg);color:var(--text);-webkit-font-smoothing:antialiased;scroll-behavior:smooth}
img{max-width:100%;display:block}
button{font:inherit;background:none;border:0;cursor:pointer;color:inherit}
a{color:inherit;text-decoration:none}
::-webkit-scrollbar{width:8px;height:8px}
::-webkit-scrollbar-thumb{background:rgba(0,0,0,.2);border-radius:8px}

.header{position:fixed;top:0;left:0;right:0;z-index:50;height:66px;display:flex;align-items:center;padding:0 14px;background:color-mix(in srgb, var(--bg-elev) 75%, transparent);backdrop-filter:var(--blur);-webkit-backdrop-filter:var(--blur);border-bottom:1px solid var(--border)}
.header-inner{max-width:1220px;margin:0 auto;width:100%;display:flex;align-items:center;gap:10px}
.logo{font-weight:900;font-size:26px;letter-spacing:.5px;font-family:"SF Pro Rounded",system-ui}
.logo span{color:var(--accent)}
.search-wrap{flex:1;position:relative}
.search{width:100%;height:42px;border-radius:21px;background:var(--bg);border:1px solid var(--border);padding:0 42px 0 16px;font-size:15px;outline:none;transition:.2s}
.search:focus{border-color:var(--accent);box-shadow:0 0 0 4px color-mix(in srgb,var(--accent) 18%, transparent)}
.search-icon{position:absolute;right:12px;top:50%;transform:translateY(-50%);opacity:.6}
.icon-btn{width:42px;height:42px;border-radius:50%;display:grid;place-items:center;background:var(--bg);border:1px solid var(--border);position:relative;transition:transform .15s}
.icon-btn:active{transform:scale(.94)}
.badge-count{position:absolute;top:-4px;right:-4px;background:var(--accent);color:white;font-size:11px;min-width:19px;height:19px;border-radius:10px;display:grid;place-items:center;padding:0 5px;font-weight:700}

main{padding-top:76px;padding-bottom:110px;max-width:1220px;margin:0 auto}

.hero{margin:14px 14px 24px;padding:48px 24px;min-height:58vh;border-radius:var(--radius-lg);background:linear-gradient(135deg,#F8EDE3 0%,#F3D8C7 35%,#EABDA0 100%);position:relative;overflow:hidden;display:grid;place-items:center;text-align:center;box-shadow:var(--shadow);transform:translateZ(0)}
[data-theme="dark"] .hero{background:linear-gradient(135deg,#2A1E1A 0%,#3D2A23 45%,#5A3B2F 100%)}
.hero::before{content:"";position:absolute;inset:-20%;background:radial-gradient(600px 300px at 70% 30%, rgba(255,255,255,.3), transparent);transform:translateY(var(--par,0))}
.hero h1{font-size:clamp(34px,6vw,60px);margin:0 0 10px;font-weight:900;letter-spacing:-.02em}
.hero p{font-size:18px;color:#5A3B2F;margin:0 0 26px}
[data-theme="dark"] .hero p{color:#E8D5C9}
.btn-primary{background:var(--text);color:var(--bg-elev);padding:14px 26px;border-radius:999px;font-weight:700;transition:transform .2s,opacity .2s;box-shadow:0 10px 24px rgba(0,0,0,.18)}
.btn-primary:hover{transform:translateY(-2px)}
.btn-primary:active{transform:translateY(0)}
.btn-ghost{background:var(--bg-elev);color:var(--text);border:1px solid var(--border);padding:10px 16px;border-radius:14px;font-weight:600}

.section{padding:22px 14px}
.section-title{display:flex;justify-content:space-between;align-items:end;margin-bottom:14px}
.section-title h2{font-size:22px;margin:0;font-weight:800;letter-spacing:-.01em}

.categories{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
@media(min-width:780px){.categories{grid-template-columns:repeat(4,1fr)}}
.cat-card{height:112px;border-radius:var(--radius-md);background:var(--bg-elev);box-shadow:var(--shadow);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:18px;position:relative;overflow:hidden;cursor:pointer;transition:transform .25s}
.cat-card:hover{transform:translateY(-3px)}
.cat-card::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent,rgba(0,0,0,.06))}

.carousel{display:flex;gap:14px;overflow-x:auto;padding:4px 2px 10px;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch}
.carousel::-webkit-scrollbar{display:none}
.carousel .card-product{min-width:220px;scroll-snap-align:start}

.grid-products{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}
@media(min-width:900px){.grid-products{grid-template-columns:repeat(4,1fr)}}

.card-product{background:var(--bg-elev);border-radius:var(--radius-md);overflow:hidden;box-shadow:var(--shadow);transition:transform .25s,box-shadow .25s;cursor:pointer;display:flex;flex-direction:column}
.card-product:hover{transform:translateY(-4px);box-shadow:0 18px 40px rgba(0,0,0,.14)}
.card-img{aspect-ratio:1/1;background:#eee;position:relative;overflow:hidden}
.card-img img{width:100%;height:100%;object-fit:cover;transition:transform .5s}
.card-product:hover .card-img img{transform:scale(1.06)}
.fav-btn{position:absolute;top:10px;right:10px;width:36px;height:36px;border-radius:50%;background:rgba(255,255,255,.92);backdrop-filter:blur(10px);display:grid;place-items:center;transition:.2s;border:1px solid rgba(0,0,0,.06)}
[data-theme="dark"] .fav-btn{background:rgba(20,20,20,.7);border-color:rgba(255,255,255,.1)}
.fav-btn.active svg{fill:var(--accent);stroke:var(--accent)}
.badge{position:absolute;top:10px;left:10px;background:var(--text);color:var(--bg-elev);font-size:11px;padding:5px 9px;border-radius:999px;font-weight:700;letter-spacing:.3px}
.badge.nuevo{background:var(--accent)}
.badge.agotado{background:#8E8E93}
.badge.poco{background:#FF9F0A;color:#000}
.card-body{padding:12px 14px 16px;display:flex;flex-direction:column;gap:4px;flex:1}
.card-body h3{font-size:15px;margin:0;font-weight:700;line-height:1.25}
.card-marca{font-size:13px;color:var(--text-2)}
.card-price{display:flex;align-items:baseline;gap:8px;margin-top:auto}
.price-now{font-weight:800;font-size:16px}
.price-old{font-size:13px;color:var(--text-2);text-decoration:line-through}

.promo-banner{margin:18px 14px;background:linear-gradient(90deg,var(--accent),var(--accent-2));color:white;border-radius:var(--radius-lg);padding:26px;box-shadow:var(--shadow);display:flex;flex-direction:column;gap:14px;align-items:center;text-align:center}
.countdown{display:flex;gap:10px}
.time{background:rgba(0,0,0,.18);padding:8px 14px;border-radius:14px;min-width:64px;backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,.15)}
.time b{display:block;font-size:22px;line-height:1}

.filters-bar{background:var(--bg-elev);border-radius:var(--radius-md);padding:16px;box-shadow:var(--shadow);margin:14px 0;display:grid;gap:14px}
.filters-row{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.chip{padding:8px 14px;border-radius:999px;border:1px solid var(--border);background:var(--bg);font-size:14px;cursor:pointer;transition:.2s;user-select:none;font-weight:600}
.chip.active{background:var(--text);color:var(--bg-elev);border-color:var(--text)}
.color-swatch{width:30px;height:30px;border-radius:50%;border:2px solid var(--bg-elev);box-shadow:0 0 0 1.5px var(--border);cursor:pointer;transition:.2s;position:relative}
.color-swatch.active{box-shadow:0 0 0 2.5px var(--accent)}
.range-wrap{display:flex;align-items:center;gap:10px;flex:1;min-width:220px}
.range-wrap input{flex:1;accent-color:var(--accent)}
.sort-select{height:40px;padding:0 12px;border-radius:12px;border:1px solid var(--border);background:var(--bg);font-size:14px;font-weight:600}

.bottom-nav{position:fixed;bottom:0;left:0;right:0;height:82px;background:color-mix(in srgb,var(--bg-elev) 86%, transparent);backdrop-filter:var(--blur);-webkit-backdrop-filter:var(--blur);border-top:1px solid var(--border);display:flex;justify-content:space-around;align-items:flex-start;padding-top:10px;z-index:40;padding-bottom:calc(10px + env(safe-area-inset-bottom))}
@media(min-width:820px){.bottom-nav{display:none}main{padding-bottom:30px}}
.bn-item{display:flex;flex-direction:column;align-items:center;gap:4px;font-size:11px;color:var(--text-2);padding:6px 12px;border-radius:14px;transition:.2s;font-weight:600}
.bn-item.active{color:var(--accent)}
.bn-item svg{width:24px;height:24px}

.modal{position:fixed;inset:0;z-index:100;display:none;place-items:center;background:rgba(0,0,0,.45);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);padding:16px}
.modal.open{display:grid}
.modal-card{background:var(--bg-elev);width:100%;max-width:1000px;max-height:92vh;overflow:auto;border-radius:var(--radius-lg);box-shadow:var(--shadow);animation:pop .3s ease}
@keyframes pop{from{opacity:0;transform:translateY(16px) scale(.98)}to{opacity:1;transform:translateY(0) scale(1)}}
.modal-body{display:grid;gap:24px;padding:24px}
@media(min-width:920px){.modal-body{grid-template-columns:1.1fr 1fr;padding:28px}}

.gallery{display:grid;gap:10px;align-content:start}
.gallery-main{aspect-ratio:1/1;background:#f0f0f0;border-radius:var(--radius-md);overflow:hidden}
.gallery-thumbs{display:flex;gap:8px;flex-wrap:wrap}
.thumb{width:72px;height:72px;border-radius:12px;overflow:hidden;border:2px solid transparent;cursor:pointer;opacity:.7;transition:.2s}
.thumb.active{border-color:var(--accent);opacity:1}

.drawer{position:fixed;top:0;right:0;bottom:0;width:100%;max-width:430px;background:var(--bg-elev);box-shadow:-24px 0 50px rgba(0,0,0,.22);z-index:200;transform:translateX(105%);transition:transform .35s cubic-bezier(.2,.8,.2,1);display:flex;flex-direction:column}
.drawer.open{transform:translateX(0)}
.drawer-header{padding:18px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--border)}
.drawer-body{flex:1;overflow:auto;padding:12px;display:flex;flex-direction:column;gap:12px}
.cart-item{display:flex;gap:12px;background:var(--bg);padding:10px;border-radius:16px;border:1px solid var(--border)}
.cart-item img{width:74px;height:74px;border-radius:12px;object-fit:cover;background:#ddd}
.qty{display:flex;align-items:center;gap:6px;background:var(--bg-elev);border:1px solid var(--border);border-radius:10px;padding:2px}
.qty button{width:26px;height:26px;display:grid;place-items:center;font-weight:800}
.drawer-footer{padding:16px;border-top:1px solid var(--border);background:var(--bg-elev);display:grid;gap:10px}
.row-sum{display:flex;justify-content:space-between;font-size:14px;color:var(--text-2)}
.row-sum.total{font-size:19px;font-weight:800;color:var(--text)}

.toast-container{position:fixed;bottom:96px;left:50%;transform:translateX(-50%);z-index:500;display:grid;gap:8px;width:min(92vw,420px);place-items:center}
.toast{background:var(--text);color:var(--bg-elev);padding:12px 18px;border-radius:14px;box-shadow:var(--shadow);font-size:14px;font-weight:600;animation:toast-in .28s;width:fit-content;max-width:100%}
@keyframes toast-in{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}

.panel{position:fixed;inset:0;z-index:180;background:var(--bg);display:none;flex-direction:column}
.panel.open{display:flex}
.panel-header{height:62px;display:flex;align-items:center;gap:12px;padding:0 16px;border-bottom:1px solid var(--border);background:color-mix(in srgb, var(--bg-elev) 80%, transparent);backdrop-filter:var(--blur)}
.panel-body{flex:1;overflow:auto}
.account-layout{max-width:1100px;margin:0 auto;width:100%;display:grid;grid-template-columns:230px 1fr;gap:24px;padding:24px}
@media(max-width:860px){.account-layout{grid-template-columns:1fr}}
.tabs{display:flex;flex-direction:column;gap:6px}
.tab-btn{text-align:left;padding:11px 14px;border-radius:12px;transition:.2s;font-weight:600;color:var(--text-2)}
.tab-btn.active{background:var(--bg-elev);box-shadow:var(--shadow);color:var(--text)}

.admin-layout{display:flex;min-height:100%}
.admin-side{width:240px;border-right:1px solid var(--border);padding:16px;background:var(--bg-elev)}
.admin-main{flex:1;padding:22px;overflow:auto;max-height:calc(100vh - 62px)}
.admin-nav{display:grid;gap:4px}
.admin-nav button{padding:10px 12px;border-radius:10px;text-align:left;font-weight:600;color:var(--text-2)}
.admin-nav button.active{background:var(--bg);color:var(--text)}

.stat-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px;margin-bottom:18px}
.stat-card{background:var(--bg-elev);padding:18px;border-radius:var(--radius-md);box-shadow:var(--shadow);border:1px solid var(--border)}
.stat-card h4{margin:0 0 6px;font-size:12px;color:var(--text-2);text-transform:uppercase;letter-spacing:.5px}
.stat-card .val{font-size:28px;font-weight:900}

.table-wrap{background:var(--bg-elev);border-radius:var(--radius-md);box-shadow:var(--shadow);border:1px solid var(--border);overflow:auto}
.table{width:100%;border-collapse:separate;border-spacing:0}
.table th{font-size:12px;text-transform:uppercase;color:var(--text-2);text-align:left;padding:12px;position:sticky;top:0;background:var(--bg-elev);border-bottom:1px solid var(--border)}
.table td{padding:12px;border-bottom:1px solid var(--border);vertical-align:middle}
.table tr:last-child td{border-bottom:0}

.input,textarea,select{width:100%;height:44px;padding:0 12px;border-radius:12px;border:1px solid var(--border);background:var(--bg);font:inherit;outline:none;transition:.2s}
textarea{height:auto;min-height:96px;padding:10px;resize:vertical}
.input:focus,textarea:focus,select:focus{border-color:var(--accent);box-shadow:0 0 0 4px color-mix(in srgb,var(--accent) 18%, transparent)}
.form-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
@media(max-width:640px){.form-grid{grid-template-columns:1fr}}
